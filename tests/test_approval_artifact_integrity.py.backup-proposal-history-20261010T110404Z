from __future__ import annotations

import hashlib
import json
import os
import subprocess
from pathlib import Path

import pytest

import src.agent as agent_module


def _run_git(repo: Path, *args: str) -> subprocess.CompletedProcess[str]:
    env = {
        **os.environ,
        "GIT_AUTHOR_NAME": "FinOps Test",
        "GIT_AUTHOR_EMAIL": "finops-test@example.invalid",
        "GIT_COMMITTER_NAME": "FinOps Test",
        "GIT_COMMITTER_EMAIL": "finops-test@example.invalid",
        "GIT_TERMINAL_PROMPT": "0",
    }
    return subprocess.run(
        ["git", *args],
        cwd=repo,
        capture_output=True,
        text=True,
        check=False,
        env=env,
    )


def _git_repo(tmp_path: Path) -> Path:
    repo = tmp_path / "repo"
    repo.mkdir()
    init = subprocess.run(
        ["git", "init", "-b", "main"],
        cwd=repo,
        capture_output=True,
        text=True,
        check=False,
    )
    if init.returncode != 0:
        subprocess.run(["git", "init"], cwd=repo, check=True, capture_output=True)
        assert _run_git(repo, "checkout", "-b", "main").returncode == 0

    (repo / "README.md").write_text("baseline\n", encoding="utf-8")
    assert _run_git(repo, "add", "--all").returncode == 0
    assert _run_git(repo, "commit", "-m", "initial commit").returncode == 0
    return repo


def _state(**overrides) -> dict:
    state = {
        "run_id": "approval-artifact-regression",
        "approved": True,
        "approval_reason": "test approval",
        "proposals": [
            {
                "provider": "aws",
                "resource_id": "aws:ec2:us-east-1:i-test",
                "action": "review_only",
                "risk": "low",
                "estimated_monthly_savings_usd": 0.0,
                "savings_basis": "unavailable",
            }
        ],
        "generated_hcl": "# test proposal\n",
        "risk_summary": [],
        "billing_summary": {"status": "unavailable"},
        "events": [],
    }
    state.update(overrides)
    return state


def _configure_git(monkeypatch: pytest.MonkeyPatch, repo: Path) -> str:
    monkeypatch.setenv("FINOPS_GIT_REPO", str(repo))
    monkeypatch.setenv("FINOPS_OUTPUT_DIR", "artifacts")
    monkeypatch.setenv("FINOPS_GIT_BRANCH_PREFIX", "finops/test")
    monkeypatch.setenv("FINOPS_GIT_AUTHOR_NAME", "FinOps Test")
    monkeypatch.setenv("FINOPS_GIT_AUTHOR_EMAIL", "finops-test@example.invalid")
    return "finops/test/approval-artifact-regression"


def test_unapproved_write_creates_no_branch_commit_or_artifacts(
    tmp_path: Path,
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    repo = _git_repo(tmp_path)
    branch = _configure_git(monkeypatch, repo)

    result = agent_module.write_branch(_state(approved=False))

    assert result["status"] == "write_blocked"
    assert _run_git(repo, "branch", "--show-current").stdout.strip() == "main"
    assert _run_git(repo, "branch", "--list", branch).stdout.strip() == ""
    assert _run_git(repo, "log", "-1", "--format=%s").stdout.strip() == "initial commit"
    assert not (repo / "artifacts").exists()
    assert _run_git(repo, "status", "--porcelain").stdout.strip() == ""


def test_rejected_interactive_approval_routes_to_reject_without_writing(
    tmp_path: Path,
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    repo = _git_repo(tmp_path)
    branch = _configure_git(monkeypatch, repo)
    monkeypatch.setattr("builtins.input", lambda _prompt: "reject")

    approved_state = agent_module.approval(_state())
    assert approved_state["approved"] is False
    assert agent_module.route_approval(approved_state) == "reject"

    rejected_state = agent_module.reject({**_state(), **approved_state})
    assert rejected_state["status"] == "rejected"
    assert _run_git(repo, "branch", "--show-current").stdout.strip() == "main"
    assert _run_git(repo, "branch", "--list", branch).stdout.strip() == ""
    assert not (repo / "artifacts").exists()
    assert _run_git(repo, "status", "--porcelain").stdout.strip() == ""


def test_manifest_hashes_every_artifact_except_manifest_itself(
    tmp_path: Path,
) -> None:
    output = tmp_path / "artifacts"
    state = _state()

    agent_module._write_artifacts(output, state)

    manifest = json.loads((output / "manifest.json").read_text(encoding="utf-8"))
    assert manifest["run_id"] == state["run_id"]
    assert manifest["algorithm"] == "sha256"
    assert set(manifest["files"]) == {
        "audit.json",
        "billing.json",
        "cost_evidence.json",
        "main.tf",
        "proposal.json",
    }
    assert "manifest.json" not in manifest["files"]

    for name, expected_digest in manifest["files"].items():
        actual_digest = hashlib.sha256((output / name).read_bytes()).hexdigest()
        assert actual_digest == expected_digest, name


def test_manifest_hash_mismatch_detects_modified_artifact(tmp_path: Path) -> None:
    output = tmp_path / "artifacts"
    agent_module._write_artifacts(output, _state())
    manifest = json.loads((output / "manifest.json").read_text(encoding="utf-8"))

    with (output / "main.tf").open("a", encoding="utf-8") as artifact:
        artifact.write("# unexpected modification\n")

    expected_digest = manifest["files"]["main.tf"]
    actual_digest = hashlib.sha256((output / "main.tf").read_bytes()).hexdigest()
    assert actual_digest != expected_digest


@pytest.mark.parametrize("approval_value", [None, False, 0, "true", "approve"])
def test_only_boolean_true_authorizes_writes(
    tmp_path: Path,
    monkeypatch: pytest.MonkeyPatch,
    approval_value,
) -> None:
    repo = _git_repo(tmp_path)
    branch = _configure_git(monkeypatch, repo)

    result = agent_module.write_branch(_state(approved=approval_value))

    assert result["status"] == "write_blocked"
    assert _run_git(repo, "branch", "--show-current").stdout.strip() == "main"
    assert _run_git(repo, "branch", "--list", branch).stdout.strip() == ""
    assert not (repo / "artifacts").exists()
    assert _run_git(repo, "status", "--porcelain").stdout.strip() == ""
