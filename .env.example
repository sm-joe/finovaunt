# Required for new installations only. Create a unique private password (12+ characters).
# Do not commit your real bootstrap password.
FINOVAUNT_BOOTSTRAP_PASSWORD=replace-with-a-unique-long-password

# Enable only when HTTPS is configured at your trusted proxy.
FINOVAUNT_SECURE_COOKIES=false

# Optional GitHub artifact synchronization (read-only Actions permission).
FINOVAUNT_GITHUB_TOKEN=

# Local-first scan settings.
FINOPS_DISCOVERY_MODE=mock
FINOPS_AWS_REGION=us-east-1
FINOPS_AWS_LOOKBACK_DAYS=14
FINOPS_AWS_MAX_RESOURCES=100
FINOPS_OUTPUT_DIR=artifacts-live

# Optional proposal workflow.
FINOPS_GIT_REPO=.
FINOPS_GIT_BRANCH_PREFIX=finops/optimization
FINOPS_REQUIRE_TFLINT=false
