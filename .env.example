# Keep mock mode as the safe default.
FINOPS_DISCOVERY_MODE=mock

# AWS live discovery settings.
FINOPS_AWS_REGION=us-east-1
FINOPS_AWS_LOOKBACK_DAYS=14
FINOPS_AWS_MAX_RESOURCES=100

# Existing artifact and Git settings.
FINOPS_OUTPUT_DIR=artifacts
FINOPS_GIT_REPO=.
FINOPS_GIT_BRANCH_PREFIX=finops/optimization

# Keep the existing Terraform validation setting.
FINOPS_REQUIRE_TFLINT=false